public class myItemsUsingComparable implements Comparable<myItemsUsingComparable> {
    private int itemNumber;
    private String itemName;
    private int units;

    public myItemsUsingComparable() {    }

    myItemsUsingComparable(int itemNumber, String itemName, int units){
        this.itemNumber = itemNumber;
        this.itemName = itemName;
        this.units = units;
    }

    void setObject(int itemNumber,String itemName,int units){
        this.itemNumber = itemNumber;
        this.itemName = itemName;
        this.units = units;
    }

    void setItemNumber(int itemNumber)
    {  this.itemNumber = itemNumber;  }

    void setItemName(String itemName)
    {  this.itemName = itemName;    }

    void setUnits(int units)
    {  this.units = units;    }


    int getUnits(){
        return units;
    }

    void getData(int it,String n,int u)
    {
        itemNumber = it;
        itemName = n;
        units = u;
    }
    void show()
    {
        System.out.println( itemNumber+" "+ itemName+" "+units);
    }
    void show(int pItemNumber, String pName,int pUnit)
    {
        System.out.println(pItemNumber+" "+pName+" "+pUnit);
    }
    @Override
    public String toString()
    {
        return "[" + itemNumber + " " + itemName + " " + units + "]";
    }

    @Override
    public int compareTo(myItemsUsingComparable o) {
        //RETURN POSITIVE VALUE WILL SWAP AND RETURN NEGATIVE VALUE WILL NOT SWAP
        if(this.units > o.units)
            return 1;
        if(this.units == o.units)
        {
            this.itemName.compareTo(o.itemName);
