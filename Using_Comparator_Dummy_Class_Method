class myItem
{
    int itno;
    String name;
    int units;

    myItem(){}

    myItem(String name)
    {
        this.name = name;
    }
    myItem(int number, String name, int unit)
    {
        itno = number;
        this.name = name;
        units = unit;
    }
    void setItemNumber(int number)
    {
        itno = number;
    }
    void setItemName(String name)
    {
        this.name = name;
    }
    void setUnits(int unit)
    {
        units = unit;
    }
    void setObject(int number, String name, int unit)
    {
        itno = number;
        this.name = name;
        units = unit;
    }
    String getItemName()
    {
        return name;
    }
    int getUnits()
    {
        return units;
    }
    void show()
    {

        System.out.println(   "Item Number = " + itno
                            + " Name  = " + name
                            + " Units in Hand = " + units);
    }

}

