    @Override
    public int compare(myItem item1, myItem item2)
    {
        //RETURN POSITIVE VALUE WILL SWAP AND RETURN NEGATIVE VALUE WILL NOT SWAP
//        if(item1.getUnits()>item2.getUnits())
//            return 1;
//        else
//            return -1;

        //if(item1.getUnits()>item2.getUnits())   ----- return +1
        //meaning if item1 is more than item2 and I am swapping
        //it means I want larger element to go at the back
